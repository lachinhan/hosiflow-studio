{
  "manifest_version": 3,
  "name": "HosiFlow Companion",
  "version": "1.0.3",
  "description": "Cầu nối tự động giữa HosiFlow Studio và phiên làm việc Muse.ai.",
  "action": {
    "default_title": "HosiFlow Companion",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://muse.ai/*",
    "https://*.muse.ai/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://muse.ai/*", "https://*.muse.ai/*"],
      "js": ["muse-bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
