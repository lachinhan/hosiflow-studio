{
  "manifest_version": 3,
  "name": "HosiFlow Companion",
  "version": "1.6.0",
  "description": "Cầu nối tự động giữa HosiFlow Studio và phiên làm việc Muse.ai, FlowMusic & Bóc tách sản phẩm Shopee / TikTok Shop.",
  "action": {
    "default_title": "HosiFlow Companion",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://muse.ai/*",
    "https://*.muse.ai/*",
    "https://flowmusic.app/*",
    "https://*.flowmusic.app/*",
    "https://www.flowmusic.app/*",
    "https://shopee.vn/*",
    "https://*.shopee.vn/*",
    "https://s.shopee.vn/*",
    "https://*.tiktok.com/*",
    "https://tiktok.com/*",
    "https://vt.tiktok.com/*",
    "https://storage.googleapis.com/*",
    "https://*.googleapis.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://muse.ai/*",
        "https://*.muse.ai/*"
      ],
      "js": [
        "muse-bridge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://flowmusic.app/*",
        "https://*.flowmusic.app/*",
        "https://www.flowmusic.app/*"
      ],
      "js": [
        "flowmusic-inpage.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://flowmusic.app/*",
        "https://*.flowmusic.app/*",
        "https://www.flowmusic.app/*"
      ],
      "js": [
        "flowmusic-adapter.js"
      ],
      "run_at": "document_idle"
    }
  ]
}